# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already excluded in .gitignore).

# --- Signaling server (rap-signaling) ---

# Port the Express/Socket.io server listens on.
PORT=4000

# CORS origin allowed to connect — set to your deployed Viewer URL
# (e.g. https://your-viewer.vercel.app) before going live. "*" is fine
# for local dev only.
ALLOWED_ORIGIN=*

# --- TURN credentials: use ONE of the three options below ---

# Option A — Metered.ca, static credential (GET flow). This matches
# generating one credential from the Metered dashboard and copying its
# apiKey — the app name is the subdomain in your dashboard's endpoint URL
# (e.g. "samadhandesk" from https://samadhandesk.metered.live/...).
# METERED_APP_NAME=your-app-name
# METERED_API_KEY=your-metered-api-key

# Option B — Metered.ca, minted credential (POST flow). Mints a genuinely
# fresh, time-limited credential per session instead of reusing one static
# one. Requires TURN_URLS to be set separately (see below) since this flow
# doesn't return server URLs itself. Ignored if METERED_API_KEY (Option A)
# is set.
# METERED_APP_NAME=your-app-name
# METERED_SECRET_KEY=your-metered-secret-key

# Option C — self-hosted coturn. Its static-auth-secret, used to sign
# short-lived TURN credentials locally (TRD §2.3). Ignored if either
# Metered option above is set.
TURN_SHARED_SECRET=dev-placeholder-secret-not-for-prod

# Only needed for Option B or C — comma-separated turn:/turns: URLs.
# Option A (static Metered credential) ignores this; its response already
# includes the URLs.
TURN_URLS=turn:turn.example.invalid:3478,turns:turn.example.invalid:5349

# Test-only override for the room code TTL (milliseconds). Leave unset in
# any deployed environment — production must use the real 120s (120000) TTL.
# ROOM_TTL_MS=120000


# --- Database (Phase 4, not needed yet) ---
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>


# --- Viewer app (Phase 2+, not needed yet) ---
# NEXT_PUBLIC_SIGNALING_URL=https://your-signaling-app.onrender.com
