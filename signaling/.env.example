PORT=4000
ALLOWED_ORIGIN=*
TURN_SHARED_SECRET=dev-placeholder-secret-not-for-prod
TURN_URLS=turn:turn.example.invalid:3478,turns:turn.example.invalid:5349
# ROOM_TTL_MS=120000


# --- CERT-In compliance logging (India-hosted VPS deployments only) ---
# Where connection/access event logs are written — separate from the app
# database, retained 180 days, never contains session content (video,
# keystrokes, mouse). See cert-in-logging-setup-guide.md for the full
# requirement. On the actual India VPS, point this at a real folder there,
# e.g. C:\logs\signaling\ — defaults to ./logs/signaling if unset.
# CERT_IN_LOG_DIR=C:\logs\signaling
# CERT_IN_LOG_RETENTION_DAYS=180


# --- Database (Phase 4, not needed yet) ---
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>


# --- Viewer app (Phase 2+, not needed yet) ---
# NEXT_PUBLIC_SIGNALING_URL=https://your-signaling-app.onrender.com
