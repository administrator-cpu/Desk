{
  "name": "rap-host",
  "version": "0.1.0",
  "description": "Electron host app for the browser-based remote access platform (Phase 3)",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
