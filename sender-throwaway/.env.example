VITE_SIGNALING_URL=http://localhost:4000

# Set to "true" to force iceTransportPolicy: "relay" — disables direct P2P
# so a successful connection proves the TURN path specifically works.
# This is implementation-plan step 2.10's cross-network test. Leave unset
# (or "false") for normal same-network use.
VITE_FORCE_RELAY=false
